  <h2>Complete Python Simulation — Google Colab</h2>
  <p>The code below reproduces every step of this experiment: group assignment, outcome simulation, metric calculation, visualization, and statistical testing. Copy and paste it into a Google Colab notebook to run it.</p>

  <div class="csec">
    <div class="chdr">
      <div class="cdots"><i></i><i></i><i></i></div>
      <span>top_tier_ab_test.py — Google Colab</span>
    </div>
<pre><span class="cm"># ════════════════════════════════════════════════════════════</span>
<span class="cm"># Top Tier Equipment — A/B Test Simulation</span>
<span class="cm"># MIS 432: AI in Business | Western Washington University</span>
<span class="cm"># Scenario: Does review placement affect purchase-through rate?</span>
<span class="cm"># 1,500 simulated shoppers | Two-Proportion Z-Test</span>
<span class="cm"># ════════════════════════════════════════════════════════════</span>

<span class="cm"># ── Step 1: Import Libraries ──────────────────────────────</span>
<span class="kw">import</span> numpy <span class="kw">as</span> np
<span class="kw">import</span> pandas <span class="kw">as</span> pd
<span class="kw">import</span> matplotlib.pyplot <span class="kw">as</span> plt
<span class="kw">from</span> scipy.special <span class="kw">import</span> ndtr
<span class="kw">import</span> warnings
warnings.<span class="fn">filterwarnings</span>(<span class="st">"ignore"</span>)

np.random.<span class="fn">seed</span>(<span class="nm">42</span>)  <span class="cm"># Locks results so simulation is reproducible</span>

<span class="cm"># ── Step 2: Define Experiment Parameters ─────────────────</span>
TOTAL_SHOPPERS = <span class="nm">1500</span>
GROUP_SIZE     = TOTAL_SHOPPERS // <span class="nm">2</span>  <span class="cm"># 750 per group</span>

<span class="cm"># Assumed purchase rates — justified by industry benchmarks</span>
<span class="cm"># and behavioral psychology (see report for full rationale)</span>
RATE_A = <span class="nm">0.038</span>  <span class="cm"># Version A: reviews at top    → 3.8% conversion</span>
RATE_B = <span class="nm">0.051</span>  <span class="cm"># Version B: reviews below CTA → 5.1% conversion</span>

<span class="cm"># ── Step 3: Simulate Shopper Behavior ────────────────────</span>
<span class="cm"># Bernoulli trial: each shopper either buys (1) or doesn't (0)</span>
group_a = np.random.<span class="fn">binomial</span>(n=<span class="nm">1</span>, p=RATE_A, size=GROUP_SIZE)
group_b = np.random.<span class="fn">binomial</span>(n=<span class="nm">1</span>, p=RATE_B, size=GROUP_SIZE)

<span class="cm"># Store results in a structured DataFrame</span>
df = pd.<span class="fn">DataFrame</span>({
    <span class="st">'user_id'</span>  : <span class="fn">range</span>(<span class="nm">1</span>, TOTAL_SHOPPERS + <span class="nm">1</span>),
    <span class="st">'version'</span>  : [<span class="st">'A'</span>] * GROUP_SIZE + [<span class="st">'B'</span>] * GROUP_SIZE,
    <span class="st">'purchased'</span>: <span class="fn">list</span>(group_a) + <span class="fn">list</span>(group_b)
})

<span class="cm"># ── Step 4: Calculate Key Metrics ────────────────────────</span>
summary = (
    df.<span class="fn">groupby</span>(<span class="st">'version'</span>)
      .<span class="fn">agg</span>(total_users=(<span class="st">'user_id'</span>, <span class="st">'count'</span>),
           total_purchases=(<span class="st">'purchased'</span>, <span class="st">'sum'</span>))
      .<span class="fn">reset_index</span>()
)
summary[<span class="st">'purchase_rate'</span>] = (
    summary[<span class="st">'total_purchases'</span>] / summary[<span class="st">'total_users'</span>]
)

conversions_a = summary.<span class="fn">loc</span>[summary[<span class="st">'version'</span>]==<span class="st">'A'</span>,
                             <span class="st">'total_purchases'</span>].<span class="fn">values</span>[<span class="nm">0</span>]
conversions_b = summary.<span class="fn">loc</span>[summary[<span class="st">'version'</span>]==<span class="st">'B'</span>,
                             <span class="st">'total_purchases'</span>].<span class="fn">values</span>[<span class="nm">0</span>]
rate_a        = conversions_a / GROUP_SIZE
rate_b        = conversions_b / GROUP_SIZE
abs_lift      = rate_b - rate_a
rel_lift      = (abs_lift / rate_a) * <span class="nm">100</span>

<span class="fn">print</span>(<span class="st">"Summary:"</span>)
<span class="fn">print</span>(summary.<span class="fn">to_string</span>(index=<span class="bi">False</span>))

<span class="cm"># ── Step 5: Visualize Results ─────────────────────────────</span>
fig, axes = plt.<span class="fn">subplots</span>(<span class="nm">1</span>, <span class="nm">2</span>, figsize=(<span class="nm">13</span>, <span class="nm">5</span>))
fig.<span class="fn">suptitle</span>(<span class="st">"Top Tier Equipment — A/B Test: Review Placement"</span>,
             fontsize=<span class="nm">14</span>, fontweight=<span class="st">'bold'</span>)
colors = [<span class="st">'#5DCAA5'</span>, <span class="st">'#3266AD'</span>]
labels = [<span class="st">'Version A\n(Reviews at top)'</span>,
          <span class="st">'Version B\n(Reviews below CTA)'</span>]

<span class="cm"># Chart 1: Purchase-through rate bar chart</span>
ax1 = axes[<span class="nm">0</span>]
bars = ax1.<span class="fn">bar</span>(labels, [rate_a*<span class="nm">100</span>, rate_b*<span class="nm">100</span>],
               color=colors, width=<span class="nm">0.5</span>,
               edgecolor=<span class="st">'white'</span>, linewidth=<span class="nm">1.5</span>)
<span class="kw">for</span> bar, r <span class="kw">in</span> <span class="fn">zip</span>(bars, [rate_a, rate_b]):
    ax1.<span class="fn">text</span>(bar.<span class="fn">get_x</span>() + bar.<span class="fn">get_width</span>()/<span class="nm">2</span>,
             bar.<span class="fn">get_height</span>() + <span class="nm">0.1</span>,
             <span class="fn">f</span><span class="st">'{r:.2%}'</span>, ha=<span class="st">'center'</span>, va=<span class="st">'bottom'</span>,
             fontsize=<span class="nm">12</span>, fontweight=<span class="st">'bold'</span>)
ax1.<span class="fn">set_ylim</span>(<span class="nm">0</span>, <span class="fn">max</span>([rate_a, rate_b]) * <span class="nm">140</span>)
ax1.<span class="fn">set_ylabel</span>(<span class="st">'Purchase-Through Rate (%)'</span>)
ax1.<span class="fn">set_title</span>(<span class="st">'Purchase-Through Rate by Version'</span>)
ax1.spines[[<span class="st">'top'</span>, <span class="st">'right'</span>]].<span class="fn">set_visible</span>(<span class="bi">False</span>)

<span class="cm"># Chart 2: Funnel (visitors / non-converters / purchasers)</span>
ax2   = axes[<span class="nm">1</span>]
cats  = [<span class="st">'Visited'</span>, <span class="st">'Did Not Convert'</span>, <span class="st">'Purchased'</span>]
va    = [GROUP_SIZE, GROUP_SIZE - conversions_a, conversions_a]
vb    = [GROUP_SIZE, GROUP_SIZE - conversions_b, conversions_b]
x     = np.<span class="fn">arange</span>(<span class="fn">len</span>(cats))
w     = <span class="nm">0.35</span>
ba = ax2.<span class="fn">bar</span>(x - w/<span class="nm">2</span>, va, w, color=colors[<span class="nm">0</span>], label=<span class="st">'Version A'</span>)
bb = ax2.<span class="fn">bar</span>(x + w/<span class="nm">2</span>, vb, w, color=colors[<span class="nm">1</span>], label=<span class="st">'Version B'</span>)
<span class="kw">for</span> bar <span class="kw">in</span> <span class="fn">list</span>(ba) + <span class="fn">list</span>(bb):
    ax2.<span class="fn">text</span>(bar.<span class="fn">get_x</span>() + bar.<span class="fn">get_width</span>()/<span class="nm">2</span>,
             bar.<span class="fn">get_height</span>() + <span class="nm">4</span>,
             <span class="fn">str</span>(<span class="fn">int</span>(bar.<span class="fn">get_height</span>())),
             ha=<span class="st">'center'</span>, va=<span class="st">'bottom'</span>, fontsize=<span class="nm">9</span>)
ax2.<span class="fn">set_xticks</span>(x)
ax2.<span class="fn">set_xticklabels</span>(cats)
ax2.<span class="fn">set_ylabel</span>(<span class="st">'Number of Shoppers'</span>)
ax2.<span class="fn">set_title</span>(<span class="st">'Shopper Funnel by Version'</span>)
ax2.<span class="fn">legend</span>()
ax2.spines[[<span class="st">'top'</span>, <span class="st">'right'</span>]].<span class="fn">set_visible</span>(<span class="bi">False</span>)

plt.<span class="fn">tight_layout</span>()
plt.<span class="fn">savefig</span>(<span class="st">'top_tier_ab_results.png'</span>, dpi=<span class="nm">150</span>, bbox_inches=<span class="st">'tight'</span>)
plt.<span class="fn">show</span>()

<span class="cm"># ── Step 6: Two-Proportion Z-Test ────────────────────────</span>
<span class="cm"># Pooled proportion (assumes null hypothesis: pA = pB)</span>
p_pool  = (conversions_a + conversions_b) / (GROUP_SIZE * <span class="nm">2</span>)
se      = np.<span class="fn">sqrt</span>(p_pool * (<span class="nm">1</span> - p_pool) *
                  (<span class="nm">1</span>/GROUP_SIZE + <span class="nm">1</span>/GROUP_SIZE))
z_score = (rate_b - rate_a) / se
p_value = <span class="nm">2</span> * (<span class="nm">1</span> - <span class="fn">ndtr</span>(<span class="fn">abs</span>(z_score)))
ci_lo   = abs_lift - <span class="nm">1.96</span> * se
ci_hi   = abs_lift + <span class="nm">1.96</span> * se
sig     = p_value &lt; <span class="nm">0.05</span>

<span class="fn">print</span>(<span class="st">"\n"</span> + <span class="st">"═"</span> * <span class="nm">52</span>)
<span class="fn">print</span>(<span class="st">"   TOP TIER EQUIPMENT — A/B TEST RESULTS"</span>)
<span class="fn">print</span>(<span class="st">"═"</span> * <span class="nm">52</span>)
<span class="fn">print</span>(<span class="fn">f</span><span class="st">"\n  Version A  : {conversions_a} purchases ({rate_a:.2%})"</span>)
<span class="fn">print</span>(<span class="fn">f</span><span class="st">"  Version B  : {conversions_b} purchases ({rate_b:.2%})"</span>)
<span class="fn">print</span>(<span class="fn">f</span><span class="st">"  Abs lift   : {abs_lift:+.2%}"</span>)
<span class="fn">print</span>(<span class="fn">f</span><span class="st">"  Rel lift   : {rel_lift:+.1f}%"</span>)
<span class="fn">print</span>(<span class="fn">f</span><span class="st">"  Z-score    : {z_score:.4f}"</span>)
<span class="fn">print</span>(<span class="fn">f</span><span class="st">"  P-value    : {p_value:.4f}"</span>)
<span class="fn">print</span>(<span class="fn">f</span><span class="st">"  95% CI     : [{ci_lo:+.4f}, {ci_hi:+.4f}]"</span>)
<span class="fn">print</span>(<span class="fn">f</span><span class="st">"  Significant : {'YES ✅' if sig else 'NO ❌'}"</span>)
<span class="fn">print</span>(<span class="st">"═"</span> * <span class="nm">52</span>)</pre>
