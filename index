<script>
(function(){
  const nA=750,nB=750,cA=29,cB=38;
  const rA=cA/nA*100,rB=cB/nB*100;

  new Chart(document.getElementById('rateChart'),{
    type:'bar',
    data:{
      labels:['Version A\n(Reviews at top)','Version B\n(Reviews below CTA)'],
      datasets:[{
        data:[rA,rB],
        backgroundColor:['rgba(93,202,165,0.85)','rgba(50,102,173,0.85)'],
        borderColor:['#1D9E75','#185FA5'],borderWidth:1.5,borderRadius:8
      }]
    },
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},
        tooltip:{callbacks:{label:c=>` ${c.raw.toFixed(2)}% purchase-through rate`}}},
      scales:{
        y:{beginAtZero:true,max:7.5,
           ticks:{callback:v=>v+'%',font:{size:12}},
           grid:{color:'rgba(100,130,160,0.12)'}},
        x:{ticks:{font:{size:12}},grid:{display:false}}
      }}
  });

  new Chart(document.getElementById('funnelChart'),{
    type:'bar',
    data:{
      labels:['Visited page','Did not convert','Purchased'],
      datasets:[
        {label:'Version A',data:[nA,nA-cA,cA],backgroundColor:'rgba(93,202,165,0.85)',borderColor:'#1D9E75',borderWidth:1,borderRadius:5},
        {label:'Version B',data:[nB,nB-cB,cB],backgroundColor:'rgba(50,102,173,0.85)',borderColor:'#185FA5',borderWidth:1,borderRadius:5}
      ]
    },
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},
        tooltip:{callbacks:{label:c=>` ${c.dataset.label}: ${c.raw} shoppers`}}},
      scales:{
        y:{beginAtZero:true,ticks:{font:{size:12}},grid:{color:'rgba(100,130,160,0.12)'}},
        x:{ticks:{font:{size:12}},grid:{display:false}}
      }}
  });

  function npdf(x){return Math.exp(-0.5*x*x)/Math.sqrt(2*Math.PI)}
  const xs=[],ys=[],rL=[],rR=[];
  for(let v=-4.5;v<=4.5;v+=0.06){
    const xr=+v.toFixed(2);
    xs.push(xr);
    ys.push(+npdf(xr).toFixed(5));
    rL.push(xr<=-1.96?+npdf(xr).toFixed(5):null);
    rR.push(xr>=1.96?+npdf(xr).toFixed(5):null);
  }

  const zc=new Chart(document.getElementById('zChart'),{
    type:'line',
    data:{labels:xs,datasets:[
      {data:ys,borderColor:'#3D5166',borderWidth:2,fill:false,pointRadius:0,tension:0.35},
      {data:rL,borderColor:'transparent',backgroundColor:'rgba(176,58,46,0.22)',fill:true,pointRadius:0,tension:0.35},
      {data:rR,borderColor:'transparent',backgroundColor:'rgba(176,58,46,0.22)',fill:true,pointRadius:0,tension:0.35}
    ]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{enabled:false}},
      scales:{
        x:{ticks:{callback:(v,i)=>{const val=xs[i];return(val===-4||val===-2||val===0||val===2||val===4)?String(val):''},maxRotation:0,font:{size:11}},
           grid:{color:'rgba(100,130,160,0.1)'}},
        y:{beginAtZero:true,ticks:{font:{size:10}},grid:{color:'rgba(100,130,160,0.1)'}}
      }}
  });

  const linePlugin={id:'zlines',afterDraw(chart){
    if(chart!==zc)return;
    const{ctx,scales:{x,y}}=chart;
    const obsX=x.getPixelForValue(1.984);
    ctx.save();
    ctx.beginPath();ctx.moveTo(obsX,y.top);ctx.lineTo(obsX,y.bottom);
    ctx.strokeStyle='#3266AD';ctx.lineWidth=2.5;ctx.setLineDash([5,4]);ctx.stroke();
    ctx.fillStyle='#3266AD';ctx.font='bold 11px DM Sans,sans-serif';
    ctx.fillText('Z\u202f=\u202f1.984',obsX+4,y.top+18);
    [-1.96,1.96].forEach(cv=>{
      const px=x.getPixelForValue(cv);
      ctx.beginPath();ctx.moveTo(px,y.top);ctx.lineTo(px,y.bottom);
      ctx.strokeStyle='rgba(176,58,46,0.5)';ctx.lineWidth=1.5;ctx.setLineDash([4,4]);ctx.stroke();
      ctx.fillStyle='rgba(176,58,46,0.75)';ctx.font='10px DM Sans,sans-serif';
      ctx.fillText(cv>0?'\u2009+1.96':'\u2009\u22121.96',px+3,y.bottom-8);
    });
    ctx.restore();
  }};
  Chart.register(linePlugin);
  zc.update();
})();
</script>
